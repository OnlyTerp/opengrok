# GrokBot Voice — local configuration (never commit this file)
# Copy to voice/.env and fill in. See voice/SETUP.md for where each value comes from.

# ---- ElevenLabs (the voice) — REQUIRED ----
# Create at https://elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=
# Voice to speak with. Use any voice ID from your ElevenLabs dashboard,
# e.g. a premade voice like "Rachel" (21m00Tcm4TlvDq8ikWAM) or your own cloned voice.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Optional: pronunciation dictionary "id:version" if you have one
#VOICE_ELEVEN_PRONUNCIATION=

# ---- OpenAI realtime (the brain) — REQUIRED ----
# Easiest: run `npx codex login` once — the token is picked up automatically
# from ~/.codex/auth.json. Or paste any OpenAI API key that has realtime access:
#VOICE_OPENAI_TOKEN=

# ---- Grok/xAI STT (the ears) — REQUIRED ----
# Log into the Grok CLI so ~/.grok/auth.json exists, or set a JWT directly:
#VOICE_GROK_JWT=

# ---- Everything below is OPTIONAL ----

# Consult roster: NAME|agent-id|alias,alias — name the assistants the voice
# brain may hand questions to. Example:
#VOICE_CONSULT_ROSTER=Fast|11111111-2222-3333-4444-555555555555|fast,cheap
#VOICE_CONSULT_DEFAULT_NAME=Fast
#VOICE_CONSULT_DEFAULT_ID=11111111-2222-3333-4444-555555555555

# Live-context source (e.g. a chat/events feed the assistant can read on air).
# Without it the read_live_context tool simply reports that no source is configured.
#VOICE_CONTEXT_HOST=127.0.0.1
#VOICE_CONTEXT_PORT=8650
#VOICE_CONTEXT_PATH=/api/v1/events?limit=120
#VOICE_CONTEXT_KEY_FILE=C:/path/to/key.txt

# Ports (defaults shown)
#VOICE_GW_PORT=18793
#VOICE_PANEL_PORT=8094
#CONSULT_GW_PORT=18795
